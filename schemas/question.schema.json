{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Structured question import data",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "id",
      "year",
      "number",
      "prompt",
      "choices",
      "answer",
      "official_answer",
      "domain",
      "status",
      "explanation_status",
      "explanation",
      "reviewer",
      "reviewed_at",
      "source",
      "issues"
    ],
    "properties": {
      "id": { "type": "string", "pattern": "^202[1-6]-[0-9]{3}$" },
      "year": { "type": "integer", "minimum": 2021, "maximum": 2026 },
      "number": { "type": "integer", "minimum": 1, "maximum": 100 },
      "prompt": { "$ref": "#/definitions/text" },
      "choices": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "uniqueItems": true,
        "items": { "$ref": "#/definitions/text" }
      },
      "answer": { "type": "integer", "minimum": 0, "maximum": 3 },
      "official_answer": { "enum": ["ア", "イ", "ウ", "エ"] },
      "domain": { "enum": ["ストラテジ", "マネジメント", "テクノロジ"] },
      "status": { "enum": ["needs_review", "draft", "verified", "published"] },
      "explanation_status": {
        "enum": ["not_generated", "generated", "needs_review", "verified", "publishable"]
      },
      "reviewer": { "type": ["string", "null"] },
      "reviewed_at": { "type": ["string", "null"] },
      "issues": { "type": "array", "items": { "$ref": "#/definitions/text" } },
      "source": {
        "type": "object",
        "required": ["question_pdf", "page", "answer_pdf", "answer_page"],
        "properties": {
          "question_pdf": { "$ref": "#/definitions/text" },
          "answer_pdf": { "$ref": "#/definitions/text" },
          "page": { "type": "integer", "minimum": 1 },
          "answer_page": { "type": "integer", "minimum": 1 }
        }
      },
      "explanation": {
        "type": "object",
        "required": ["answer", "reasons", "terms", "point"],
        "properties": {
          "answer": { "type": "integer", "minimum": 0, "maximum": 3 },
          "reasons": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": { "$ref": "#/definitions/text" }
          },
          "terms": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/text" } },
          "point": { "$ref": "#/definitions/text" }
        }
      }
    }
  },
  "definitions": { "text": { "type": "string", "pattern": "\\S" } }
}
